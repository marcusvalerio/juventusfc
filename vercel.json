{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://juventusfc-production.contatomarcusjr.workers.dev/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci"
}
