{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "juventusfc",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The built SPA is served by the Worker; unknown paths fall back to index.html
  // so client-side routing keeps working on deep links.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "juventusfc",
      // Replace with the id printed by `wrangler d1 create juventusfc`.
      // Local development ignores this value and uses a local SQLite file.
      "database_id": "8089c853-9b9c-40a9-a86c-132b60c31961",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "development",
    // Development mail sink: the reset message is stored in `mail_outbox` so the
    // flow can be exercised locally. Refused outside development, and never
    // reachable over HTTP — read it with `wrangler d1 execute`.
    "MAIL_PROVIDER": "capture",
    // Empty falls back to the origin the Worker was reached on.
    "APP_ORIGIN": ""
  },

  "env": {
    "production": {
      // APP_ORIGIN must carry the public domain: behind the Vercel rewrite the
      // Worker only ever sees its own hostname, and a reset link built from that
      // would point at the wrong host. MAIL_PROVIDER stays unset until a real
      // provider exists — resets are recorded and nothing is delivered.
      "vars": { "ENVIRONMENT": "production", "APP_ORIGIN": "" },
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "juventusfc",
          "database_id": "8089c853-9b9c-40a9-a86c-132b60c31961",
          "migrations_dir": "migrations"
        }
      ]
    }
  }

  // R2 for crests/documents — enable when file upload lands:
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "juventusfc-files" }]
}
