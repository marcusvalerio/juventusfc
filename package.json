{
  "name": "juventus-fc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:worker dev:web",
    "dev:web": "vite",
    "dev:worker": "wrangler dev --port 8787 --local",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev --port 8787 --local",
    "lint": "tsc -b --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:reset": "rm -rf .wrangler/state && wrangler d1 migrations apply DB --local",
    "db:studio": "wrangler d1 execute DB --local --command",
    "test:api": "node tests/api.e2e.mjs",
    "deploy": "npm run build && wrangler deploy --env production",
    "test:ui": "node tests/ui.e2e.mjs",
    "test:first-access": "node tests/first-access.e2e.mjs",
    "test:mascot": "node tests/mascot.e2e.mjs",
    "test:password-reset": "node tests/password-reset.e2e.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "framer-motion": "^11.11.17",
    "hono": "^4.13.7",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.170.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.130.0"
  }
}
